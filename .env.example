# Copy this file to .env and replace the placeholder password before starting PostgreSQL.
POSTGRES_DB=campus_auction
POSTGRES_USER=campus_auction
POSTGRES_PASSWORD=replace-with-a-local-password

# The API uses this URL. Keep its credentials aligned with the PostgreSQL settings above.
DATABASE_URL=postgresql+psycopg://campus_auction:replace-with-a-local-password@localhost:5432/campus_auction

# Use a separate database for authentication tests.
TEST_DATABASE_URL=postgresql+psycopg://campus_auction:replace-with-a-local-password@localhost:5432/campus_auction_test

# Comma-separated browser origins allowed to call the API.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Frontend API origin; Vite reads this value when started from frontend/.
VITE_API_BASE_URL=http://localhost:8000

# Generate a random secret of at least 32 characters for local development.
JWT_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
ACCESS_TOKEN_EXPIRE_MINUTES=15
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
