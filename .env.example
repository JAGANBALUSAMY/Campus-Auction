# Copy this file to .env and replace the placeholder password before starting PostgreSQL.
POSTGRES_DB=campus_auction
POSTGRES_USER=campus_auction
POSTGRES_PASSWORD=replace-with-a-local-password

# The API uses this URL. Keep its credentials aligned with the PostgreSQL settings above.
DATABASE_URL=postgresql+psycopg://campus_auction:replace-with-a-local-password@localhost:5432/campus_auction

# Comma-separated browser origins allowed to call the API.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Frontend API origin; Vite reads this value when started from frontend/.
VITE_API_BASE_URL=http://localhost:8000
